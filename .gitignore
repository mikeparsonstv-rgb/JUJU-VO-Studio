# JUJU VO Studio — keep evidence, private audio, model weights and envs out of git
.DS_Store
.build/
*.xcuserstate
xcuserdata/
DerivedData/

# Private production media and frozen bench evidence (never committed)
Evidence/**
!Evidence/frozen-baseline/
!Evidence/frozen-baseline/*.sha256
RendererBench/BenchData/
RendererBench/birmingham 01/
