# Isolated Python envs, model caches, analysis envs
RendererBench/.renderer-envs/
RendererBench/.renderer-models/
RendererBench/.analysis-envs/
RendererBench/.analysis-models/
**/__pycache__/
**/.venv/

# Job media library (set in Stage 1)
Library/

RendererBench/BenchAssets/rb006-local-assets.json
